rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function activeMemberPath(budgetId) {
      return /databases/$(database)/documents/budgets/$(budgetId)/active_members/$(request.auth.uid);
    }

    // `active_members/{uid}` exists exactly while the user has an ACTIVE
    // membership; the server creates/deletes it in the same transaction as the
    // membership document.
    function isActiveMember(budgetId) {
      return signedIn() && exists(activeMemberPath(budgetId));
    }

    function isActiveAdmin(budgetId) {
      return isActiveMember(budgetId)
        && get(activeMemberPath(budgetId)).data.role == 'ADMIN';
    }

    function hasVerifiedEmail() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email != null;
    }

    // All writes to identity, budget, membership and invitation data go
    // through trusted server code (Admin SDK); clients are read-only here.
    match /users/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow write: if false;
    }

    match /user_preferences/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow write: if false;
    }

    match /budgets/{budgetId} {
      allow read: if isActiveMember(budgetId);
      allow write: if false;

      match /active_members/{memberUserId} {
        allow read: if isActiveMember(budgetId);
        allow write: if false;
      }
    }

    match /memberships/{membershipId} {
      allow read: if signedIn()
        && (resource.data.user_id == request.auth.uid
          || isActiveMember(resource.data.budget_id));
      allow write: if false;
    }

    match /accounts/{accountId} {
      allow read: if isActiveMember(resource.data.budget_id);
      allow write: if false;
    }

    match /import_batches/{importBatchId} {
      allow read: if isActiveMember(resource.data.budget_id);
      allow write: if false;
    }

    match /import_periods/{importPeriodId} {
      allow read: if isActiveMember(resource.data.budget_id);
      allow write: if false;
    }

    match /transactions/{transactionId} {
      allow read: if isActiveMember(resource.data.budget_id);
      allow write: if false;
    }

    match /split_items/{splitItemId} {
      allow read: if isActiveMember(resource.data.budget_id);
      allow write: if false;
    }

    match /categories/{categoryId} {
      allow read: if isActiveMember(resource.data.budget_id);
      allow write: if false;
    }

    match /spending_limits/{limitId} {
      allow read: if isActiveMember(resource.data.budget_id);
      allow write: if false;
    }

    match /categorization_rules/{ruleId} {
      allow read: if isActiveMember(resource.data.budget_id);
      allow write: if false;
    }

    match /tags/{tagId} {
      allow read: if isActiveMember(resource.data.budget_id);
      allow write: if false;
    }

    match /transaction_tags/{transactionTagId} {
      allow read: if signedIn()
        && resource != null
        && exists(/databases/$(database)/documents/transactions/$(resource.data.transaction_id))
        && isActiveMember(get(/databases/$(database)/documents/transactions/$(resource.data.transaction_id)).data.budget_id);
      allow write: if false;
    }

    match /account_balance_snapshots/{snapshotId} {
      allow read: if signedIn()
        && exists(/databases/$(database)/documents/accounts/$(resource.data.account_id))
        && isActiveMember(get(/databases/$(database)/documents/accounts/$(resource.data.account_id)).data.budget_id);
      allow write: if false;
    }

    match /transfer_groups/{transferGroupId} {
      allow read: if isActiveMember(resource.data.budget_id);
      allow write: if false;
    }

    match /import_batch_file_hashes/{hashId} {
      allow read, write: if false;
    }

    match /statement_bank_transaction_keys/{keyId} {
      allow read, write: if false;
    }

    match /statement_fingerprint_keys/{keyId} {
      allow read, write: if false;
    }

    // Invitation e-mails are stored lower-case by the server.
    match /invitations/{invitationId} {
      allow read: if isActiveAdmin(resource.data.budget_id)
        || (hasVerifiedEmail()
          && resource.data.invitee_email == request.auth.token.email.lower());
      allow write: if false;
    }

    // Placeholder for budget-scoped data until Stage 2+ (Stage 0 access prototype).
    match /budget_records/{budgetId}/items/{itemId} {
      allow read, write: if isActiveMember(budgetId);
    }
  }
}
