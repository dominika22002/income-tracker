VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-income-tracker.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-income-tracker
VITE_FIREBASE_APP_ID=demo-income-tracker-app-id
VITE_USE_FIREBASE_EMULATOR=true
# Development-only account, available only when Firebase emulators are enabled.
VITE_REQUIRE_AUTH=false
VITE_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
VITE_FIREBASE_FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
VITE_FIREBASE_FUNCTIONS_EMULATOR_HOST=127.0.0.1:5001
GOOGLE_OAUTH_CLIENT_ID=replace-me.apps.googleusercontent.com
GOOGLE_OAUTH_REDIRECT_URI=income-tracker://oauth
